      }
    },
    {
      "title": "Disk Usage",
      "description": "Disk usage percentage across Chive hosts",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes{project=\"chive-charities\", fstype!~\"tmpfs|overlay\"} - node_filesystem_free_bytes{project=\"chive-charities\", fstype!~\"tmpfs|overlay\"}) / node_filesystem_size_bytes{project=\"chive-charities\", fstype!~\"tmpfs|overlay\"} * 100",
          "legendFormat": "{{ service }} - {{ mountpoint }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "title": "Network Traffic",
      "description": "Network I/O across Chive hosts",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{project=\"chive-charities\", device!~\"lo\"}[5m])",
          "legendFormat": "{{ service }} rx"
        },
        {

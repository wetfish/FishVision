      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_free_bytes{project=\"chive-charities\"} / node_memory_total_bytes{project=\"chive-charities\"})) * 100",

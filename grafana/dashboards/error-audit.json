{
  "title": "Error Audit \u2014 All Apps",
  "uid": "error-audit",
  "tags": [
    "errors",
    "audit",
    "chive-charities",
    "screaming-eagle",
    "kubernetes"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "type": "custom",
        "current": {
          "text": "All",
          "value": ".+"
        },
        "options": [
          {
            "text": "All",
            "value": ".+"
          },
          {
            "text": "chive-charities",
            "value": "chive-charities"
          },
          {
            "text": "screaming-eagle",
            "value": "screaming-eagle"
          }
        ],
        "multi": true,
        "includeAll": true,
        "label": "Project",
        "query": "chive-charities,screaming-eagle",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "API Errors/sec",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{status_code=~\"STATUS_CODE_ERROR\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "links": [
            {
              "title": "\ud83d\udd0e View error traces",
              "url": "/explore?left=%7B%22datasource%22%3A%20%22tempo%22%2C%20%22queries%22%3A%20%5B%7B%22refId%22%3A%20%22A%22%2C%20%22queryType%22%3A%20%22traceql%22%2C%20%22query%22%3A%20%22%7Bstatus.code%3D2%7D%22%7D%5D%2C%20%22range%22%3A%20%7B%22from%22%3A%20%22%24%7B__from%7D%22%2C%20%22to%22%3A%20%22%24%7B__to%7D%22%7D%7D",
